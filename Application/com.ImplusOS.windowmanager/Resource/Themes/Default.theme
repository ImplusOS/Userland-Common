; ImplusOS shell theme.
;
; The palette is a fixed light or dark set of neutrals plus one accent
; colour (Userland/API/Source/Theme.h). Settings writes the user's choice to
; /var/System/shell.theme, which is applied on top of this file.

accent          = #6750A4
mode            = light

[Metrics]
title_height    = 27
corner_radius   = 8
shadow_size     = 8
dock_height     = 40
