# Program profile for /Userland/FireFox/Resource/firefox-bin (Firefox
# itself; the launcher starts it directly rather than through the tarball's
# `firefox` stub -- see ../Start.c). Every process Firefox starts inherits
# this. The X11/fontconfig/GTK variables come from the x11-client role
# profile, which is loaded after this file.
#
# Format: see Userland/API/Source/LinuxEnv.h. "NAME=VALUE" per line; the
# first value given for a name wins.

# XSession hosts an X server; there is no Wayland compositor on the
# display Firefox is given. desktop.env's GDK_BACKEND=wayland,x11 would
# make GTK probe Wayland first, and Firefox's own widget code picks its
# backend from MOZ_ENABLE_WAYLAND/WAYLAND_DISPLAY before GTK is asked.
GDK_BACKEND=x11
MOZ_ENABLE_WAYLAND=0
